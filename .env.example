# Variable names only. Values are set in .env.local and in Vercel project settings.
# SESSION_SECRET and TOKEN_ENCRYPTION_KEY: 32 random bytes, base64 (openssl rand -base64 32).

SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the SnapTrade Dashboard.
SNAPTRADE_REDIRECT_URI=
APP_BASE_URL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=

# Development only (ignored in production builds): generated brokerage data
# instead of SnapTrade. One of: full, us, empty, sandbox.
VAULTFOLIO_MOCK_DATA=
